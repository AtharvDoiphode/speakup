# Copy this file to .env and fill in real values. Never commit .env.
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/speakup?appName=<app>
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
CLIENT_URL=http://localhost:5173
# Family members must enter this code to register
SIGNUP_CODE=choose-a-family-code
# The account registered with this email becomes admin
ADMIN_EMAIL=you@example.com
