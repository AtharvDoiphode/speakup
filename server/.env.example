# Copy this file to .env and fill in real values. Never commit .env.
# The server checks these at startup and stops with a clear message if one is missing.

# development locally; Render sets production
NODE_ENV=development
# Render sets PORT itself; 5000 is the local default
PORT=5000

# Required. Atlas connection string (Atlas > Connect > Drivers). MONGO_URI also works (older name)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/speakup?appName=<app>
# Required, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
# Required. Where the app is opened: http://localhost:5173 locally, your Render URL in production.
# CLIENT_URL also works (older name)
CLIENT_ORIGIN=http://localhost:5173
# Required. The account registered with this email becomes admin
ADMIN_EMAIL=you@example.com
# Required. From aistudio.google.com
GEMINI_API_KEY=

# Optional. Family members must enter this code to register (the admin can change it in Settings)
SIGNUP_CODE=
# Optional. These are the defaults
GEMINI_MODEL=gemini-3-flash-preview
# Tried in order when the model above is busy, out of quota or too slow
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.1-flash-lite-preview
# Which day a session counts for (streaks, minutes today)
APP_TIMEZONE=Asia/Kolkata
# AI requests per person per day (on top of 15 a minute). Resets at midnight in APP_TIMEZONE
AI_DAILY_LIMIT=100
